generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Buku {
  id      Int     @id @default(autoincrement())
  judul   String
  penulis String
  tahun   Int
  stok    Int     @default(0)
}