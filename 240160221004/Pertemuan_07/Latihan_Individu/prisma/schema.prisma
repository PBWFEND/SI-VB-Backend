generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
   url      = env("DATABASE_URL")
}

model Buku {
  id      Int     @id @default(autoincrement())
  judul   String
  penulis String
  tahun   Int
  stok    Int     @default(0)
}

// ===== TAMBAHKAN MODEL INI UNTUK LATIHAN =====
model Pengguna {
  id    Int     @id @default(autoincrement())
  nim   String  @unique
  nama  String
  email String  @unique
  role  String  @default("mahasiswa")
}