generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
   url      = env("DATABASE_URL")
}

model Pengguna {
  id    Int     @id @default(autoincrement())
  nim   String  @unique
  nama  String
  email String  @unique
  role  String  @default("mahasiswa")
}