generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Buku {
  id        Int      @id @default(autoincrement())
  judul     String
  penulis   String
  penerbit  String?
  tahun     Int?
  stok      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}