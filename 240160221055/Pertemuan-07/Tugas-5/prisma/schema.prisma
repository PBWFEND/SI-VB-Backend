generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Anggota {
  id     Int    @id @default(autoincrement())
  nama   String
  npm    String @unique
  divisi String

  @@map("anggota")
}
