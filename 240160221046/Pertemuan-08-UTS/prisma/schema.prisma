datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model Menu {
  id        Int      @id @default(autoincrement())
  nama      String
  harga     Int
  kategori  String
  tersedia  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

