generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Laboratorium {
  id        Int      @id @default(autoincrement())
  nama      String
  kapasitas Int
  lokasi    String
  status    String   @default("tersedia")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}